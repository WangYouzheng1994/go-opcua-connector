# go-opcua-connector 配置示例
#
# 使用方法：
#   1. 在项目根目录执行：Copy-Item config.yaml.example config.yaml
#   2. 修改下面标为【首次测试必改】的配置。
#   3. 从项目根目录启动程序。程序读取“当前工作目录”下的 config.yaml，
#      相对的日志、证书路径也以当前工作目录为基准。
#   4. config.yaml 已被 .gitignore 忽略，可保存本机账号、密码和证书路径；
#      请勿把真实凭据写回本示例文件。
#
# 首次测试最少需要确认 5 项：
#   1. opcua.endpoint：OPC UA 服务地址。
#   2. OPC UA 的账号及安全策略：匿名无安全连接可保持示例值，否则按服务端修改。
#   3. collector.subscription_nodes：至少填写一个真实存在的 Variable 或 Object NodeID。
#   4. collector.output_type：选择 nats 或 mqtt。
#   5. 所选消息中间件的地址、账号和发布主题。
#
# 标量配置可以用大写环境变量覆盖，层级之间使用下划线，例如：
#   $env:OPCUA_ENDPOINT = "opc.tcp://192.168.1.100:49320"
#   $env:COLLECTOR_OUTPUT_TYPE = "mqtt"
# subscription_nodes、point_id_overrides 等数组建议直接写在 YAML 中。

# 应用名称，只用于日志标识。通常保持默认。
app_name: go-opcua-connector

# pprof HTTP 端口。访问 http://localhost:6060/debug/pprof/ 查看性能信息。
# 当前绑定所有网卡；端口启动失败只记录警告，不影响采集进程继续运行。
pprof_port: 6060

log:
  # 日志级别：debug / info / warn / error。
  # 首次联调可用 debug，稳定运行后建议改回 info。
  level: info

  # 日志目录。相对路径以程序启动时的当前工作目录为基准。
  dir: ./logs

  # 轮转日志保留天数。小于等于 0 会恢复默认值 3。
  max_age_day: 3

  # 单个日志文件的最大大小，单位 MB。小于等于 0 会恢复默认值 100。
  max_size_mb: 100

opcua:
  # 【首次测试必改】OPC UA Endpoint，格式为 opc.tcp://主机:端口。
  # KepServer 常见示例：opc.tcp://192.168.1.100:49320
  endpoint: opc.tcp://localhost:49320

  # 客户端证书和私钥。仅当两项都非空时才启用证书身份。
  # 安全连接通常还需要先在 OPC UA 服务端信任该客户端证书。
  certificate: ""
  private_key: ""

  # 用户身份。当前实现仅当用户名和密码都非空时才启用账号认证；
  # 两项都为空表示匿名连接。
  username: ""
  password: ""

  # 【首次测试确认】安全策略和安全模式必须与服务端暴露的 Endpoint 一致。
  # 常用策略：None / Basic256Sha256；依赖也支持服务端提供的其他策略。
  # 常用模式：None / Sign / SignAndEncrypt。
  # 本地无安全联调可使用 None + None；生产环境按服务端安全要求配置。
  # 注意：当前实现找不到指定组合时会记录警告，并尝试回退到 None + None，
  # 因此连接成功后仍应检查日志中的最终 security_policy 和 security_mode。
  security_policy: None
  security_mode: None

  # OPC UA 请求超时，单位秒。用于端点发现、连接和 Adapter 协议请求。
  request_timeout: 30

  # 可选：为完整 OPC UA NodeID 指定稳定、协议无关的 PointID。
  # source_ref 必须是完整 NodeID；point_id 是上报消息 values[].id 的值。
  # 未配置覆盖时，PointID 根据完整 BrowsePath 生成，忽略 Objects 根段，
  # 各段以“.”连接；BrowseName 中原有的“.”会编码成 %2E，“%”编码成 %25。
  # 同一 SourceRef 经多条 BrowsePath 发现时，显式覆盖也用于裁决身份歧义。
  point_id_overrides: []
  # point_id_overrides:
  #   - source_ref: "ns=2;s=Channel1.Device1.Temperature"
  #     point_id: "boiler.temperature"

collector:
  # 【首次测试必改】输出目标：nats 或 mqtt。一次运行只选择一种。
  output_type: nats

  # 【首次测试必改】需要采集的 OPC UA NodeID 列表。实际运行至少要有一个有效点。
  #
  # 支持三种发现方式：
  #   1. Variable NodeID：只采集该点。
  #   2. Object NodeID，不带 .*：只采集该 Object 的直接 Variable 子节点。
  #   3. Object NodeID，带 .*：递归进入子 Object，采集所有 Variable 叶子。
  #
  # NodeID 常见格式：
  #   ns=2;s=Channel1.Device1.Temperature   字符串标识
  #   ns=2;i=1234                           数字标识
  #
  # KepServer 示例：
  #   单点：         ns=2;s=Channel1.Device1.Temperature
  #   设备直接子点： ns=2;s=Channel1.Device1
  #   设备递归采集： ns=2;s=Channel1.Device1.*
  #
  # 建议首次测试先填 1～5 个确定存在的点，验证成功后再扩大范围。
  subscription_nodes:
    - ns=2;s=Channel1.Device1.Temperature

  # 推送模式：
  #   timed：每隔 push_interval_sec 取得一次当前 StateStore 全量快照并发送。
  #   immediate：订阅值或健康状态变化后发送合并后的最新变化点。
  # immediate 关注最新状态，不保证把同一点的每个中间变化都逐条发送。
  # 首次测试建议 timed，便于持续观察完整点表。
  push_mode: timed

  # timed 模式的全量快照推送间隔，单位秒；immediate 模式不使用。
  # 点位多时，间隔越短，消息量和序列化开销越大。
  push_interval_sec: 1

  # 每条上报消息最多包含的数据点数量。
  # immediate 的合并变化和 timed 的全量快照都会先执行质量过滤，再按此值拆批。
  # 例如最终有 250 个点、batch_size=100，会发送 100/100/50 三条消息。
  batch_size: 100

  # 每一批发送到 NATS 或 MQTT 的超时，单位毫秒。
  # 这是当前生产发布链路真正使用的发布超时配置。
  publish_timeout_ms: 5000

  # 数据发布 Subject/Topic。
  # NATS 模式直接使用该值；MQTT 模式优先使用 mqtt.topic。
  subscription_topic: opcua/data

  # 主动验证间隔，单位秒。主动 Read 只确认当前订阅值是否可信，
  # 不会覆盖更新的订阅 Value；稳定不变化的点也能借此刷新 LastConfirmedAt。
  heartbeat_interval_sec: 5

  # 超过该时长未被订阅或主动验证确认时，将点标为 Stale，单位秒。
  # Stale 仍保留最近值。建议明显大于 heartbeat_interval_sec 和 read_timeout_sec，
  # 避免网络抖动时频繁进入 Stale。
  stale_threshold_sec: 30

  # 发现失败、订阅失败或确认失配后的重试间隔，单位秒。
  # 单点失败不会直接终止整个采集器。
  subscription_retry_interval_sec: 30

  # 初始读取和周期主动验证时，每个 OPC UA Read 请求包含的最大点数。
  read_batch_size: 500

  # 每个主动读取批次的独立超时，单位秒。
  read_timeout_sec: 10

  # immediate 模式下，主动验证确认状态时是否也触发发送。
  # false：主要发送订阅变化和健康状态变化，流量较小。
  # true：即使值不变，验证成功也可持续向下游发送当前状态。
  # timed 模式本身会周期发送全量快照，因此该项不影响 timed 的定时发送。
  force_heartbeat: false

  # 是否在发送前过滤非 Healthy 点。
  # false：保留异常点并通过消息 q=false 告知下游，适合联调和质量监控。
  # true：异常、无效或 Stale 点都不发送，但仍保留在 StateStore 中。
  filter_bad_quality: false

  # 采集统计日志输出间隔，单位秒。
  # 小于等于 0 会恢复默认值 60，当前不能用 0 关闭统计日志。
  monitor_interval_sec: 60

  # 【兼容字段】旧 worker/channel 架构已移除，当前 StateStore 采集链路不使用。
  # 保留它们只为兼容已有配置，不需要为性能测试调整。
  worker_count: 10
  channel_buffer_size: 10000

nats:
  # 【output_type=nats 时必改】NATS 地址，多个地址用逗号分隔。
  urls: nats://localhost:4222

  # 当前实现仅当用户名和密码都非空时才启用账号认证。
  username: ""
  password: ""

  # -1：持续重连；0：不重连；正数：最大重连次数。
  max_reconnects: -1

  # 两次 NATS 重连之间的等待时间，单位毫秒。
  reconnect_wait_ms: 1000

  # 当前使用 Core NATS Publish，没有 JetStream 持久化和消费确认。
  # Publish 成功表示客户端已完成发送，不代表下游业务已经处理。

mqtt:
  # 【output_type=mqtt 时必改】Broker 地址，多个地址用逗号分隔。
  # 无 TLS 示例：tcp://localhost:1883
  # TLS 示例：   ssl://mqtt.example.com:8883
  brokers: tcp://localhost:1883

  # 客户端 ID 必须在 Broker 中唯一；留空时程序自动生成。
  client_id: ""

  # Broker 账号。是否允许匿名连接取决于 Broker 配置。
  username: ""
  password: ""

  # MQTT 数据发布 Topic。MQTT 模式下优先于 collector.subscription_topic。
  topic: opcua/data

  # MQTT QoS：0=最多一次，1=至少一次，2=恰好一次。
  # QoS 只描述 MQTT 协议投递级别，不等于下游业务处理确认。
  qos: 0

  # 是否将每批数据设为 retained message。
  retained: false

  # true 表示重连时不恢复旧会话；回写命令订阅也使用该客户端连接。
  clean_session: true

  # MQTT Keep Alive 和首次连接超时，单位秒。
  keepalive_sec: 60
  connect_timeout_sec: 10

  # 【兼容字段】当前 PublishBatch 不读取本字段。
  # 实际生产发送超时由 collector.publish_timeout_ms 控制。
  publish_timeout_sec: 5

  # MQTT 客户端断线后是否自动重连，以及重连等待上限（秒）。
  auto_reconnect: true
  max_reconnect_delay_sec: 60

  # TLS 客户端证书和私钥：仅当两项都非空时加载，用于双向 TLS。
  tls_cert_file: ""
  tls_key_file: ""

  # 用于验证 Broker 服务端证书的 CA 文件；普通单向 TLS 通常只需配置它。
  tls_ca_file: ""

  # 跳过 Broker 证书校验，仅可用于临时联调。
  insecure_skip_verify: false

writeback:
  # 接收回写命令和发布回写结果的 Subject/Topic。
  # NATS、MQTT 共用这两个字段，并随 collector.output_type 选择传输。
  # 当前没有独立的 writeback_enabled 开关，程序会尝试启动回写监听。
  write_subject: opcua/write
  result_subject: opcua/write/result

  # 首次只测试采集时，不向 write_subject 发送消息即可，不会主动写点。
  # 如需测试回写，优先使用完整 NodeID，避免短 PointID 在多命名空间中产生歧义：
  # {"node_id":"ns=2;s=Channel1.Device1.SetPoint","value":"25.5","value_type":"float64","request_id":"test-001"}
  # value_type 可选：int32 / int64 / float32 / float64 / bool / string；留空时尝试推断。
