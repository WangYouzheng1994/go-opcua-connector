# ============================================================
# go-opcua-connector 配置文件
# 使用说明：
#   1. 复制此文件为 config.yaml
#   2. 根据实际环境修改各项配置
#   3. 支持通过环境变量覆盖配置（将层级以_连接并大写）
#      例如：$env:COLLECTOR_PUSH_MODE = "immediate"
# ============================================================

# -------------------- 应用基础配置 --------------------
app_name: go-opcua-connector
# 应用名称，用于日志标识和进程监控
# 类型：字符串
# 默认值：go-opcua-connector
# 建议：保持默认即可

# pprof性能分析端口
# 类型：整数
# 默认值：6060
# 说明：通过 http://localhost:6060/debug/pprof 访问性能分析界面
pprof_port: 6060

# -------------------- 日志配置 --------------------
log:
  # 日志输出级别
  # 类型：字符串，可选值 debug / info / warn / error
  # 默认值：info
  # 说明：
  #   - debug：输出详细调试信息，生产环境慎用
  #   - info：输出常规运行信息（推荐）
  #   - warn：只输出警告和错误
  #   - error：只输出错误信息
  level: info

  # 日志文件存放目录
  # 类型：字符串，相对路径或绝对路径
  # 默认值：./logs
  # 说明：程序启动时自动创建目录，日志写入该目录下的 app.log
  dir: ./logs

  # 日志保留天数
  # 类型：整数
  # 默认值：3
  # 说明：超过此天数的轮转日志文件自动删除
  max_age_day: 3

  # 单个日志文件最大大小
  # 类型：整数，单位MB
  # 默认值：100
  # 说明：app.log 超过此大小时自动轮转，旧文件加时间戳保留
  max_size_mb: 100


# -------------------- OPC UA 服务器配置 --------------------
opcua:
  # OPC UA 服务器连接地址
  # 类型：字符串，格式 opc.tcp://host:port
  # 默认值：无（必填）
  # 示例：
  #   - opc.tcp://localhost:49320        （KepServer默认端口）
  #   - opc.tcp://192.168.1.100:4840     （远程服务器）
  endpoint: opc.tcp://localhost:49320

  # 客户端证书文件路径（用于安全认证）
  # 类型：字符串，文件路径
  # 默认值：空（不使用证书）
  # 说明：使用安全连接时需要提供 X.509 证书
  certificate: ""

  # 客户端私钥文件路径（用于安全认证）
  # 类型：字符串，文件路径
  # 默认值：空（不使用私钥）
  # 说明：需与证书配对使用
  private_key: ""

  # 用户名（用于用户认证）
  # 类型：字符串
  # 默认值：空（匿名连接）
  # 说明：如果服务器需要认证，填写用户名
  username: ""

  # 密码（用于用户认证）
  # 类型：字符串
  # 默认值：空（匿名连接）
  # 说明：与用户名配对使用
  password: ""

  # 安全策略
  # 类型：字符串，可选值 None / Basic128Rsa15 / Basic256 / Basic256Sha256
  # 默认值：None
  # 说明：
  #   - None：不加密，不签名（测试环境）
  #   - Basic128Rsa15：128位加密，RSA15签名（兼容性优先）
  #   - Basic256：256位加密，RSA签名（平衡模式）
  #   - Basic256Sha256：256位加密，SHA256签名（推荐，安全优先）
  security_policy: None

  # 安全模式
  # 类型：字符串，可选值 None / Sign / SignAndEncrypt
  # 默认值：None
  # 说明：
  #   - None：不签名，不加密
  #   - Sign：签名但不加密（验证数据完整性）
  #   - SignAndEncrypt：签名并加密（推荐，完整保护）
  security_mode: None

  # 请求超时时间
  # 类型：整数，单位秒
  # 默认值：30
  # 说明：每个OPC UA请求的超时时间
  request_timeout: 30


# -------------------- NATS 消息中间件配置 --------------------
nats:
  # NATS 服务器地址
  # 类型：字符串，支持多个服务器（逗号分隔）
  # 默认值：无（必填）
  # 示例：
  #   - nats://localhost:4222
  #   - nats://192.168.0.69:4222,nats://192.168.0.70:4222
  urls: nats://localhost:4222

  # 用户名（用于NATS认证）
  # 类型：字符串
  # 默认值：空（匿名连接）
  # 说明：如果NATS服务器启用了认证，填写用户名
  username: ""

  # 密码（用于NATS认证）
  # 类型：字符串
  # 默认值：空（匿名连接）
  # 说明：与用户名配对使用
  password: ""

  # 最大重连次数
  # 类型：整数
  # 默认值：-1（无限重试）
  # 说明：
  #   - -1：无限重连，直到连接成功
  #   - 0：不重连，连接失败直接报错
  #   - N>0：最多重连N次后放弃
  max_reconnects: -1

  # 重连等待时间
  # 类型：整数，单位毫秒
  # 默认值：1000
  # 说明：每次重连失败后，等待多久再尝试
  reconnect_wait_ms: 1000


# -------------------- MQTT 消息中间件配置（output_type=mqtt 时生效） --------------------
mqtt:
  # MQTT Broker地址
  # 类型：字符串，多个用逗号分隔
  # 示例：tcp://localhost:1883 或 ssl://mqtt.example.com:8883
  brokers: tcp://localhost:1883

  # 客户端ID（MQTT协议要求唯一，为空自动生成）
  client_id: ""

  # 用户名/密码（Broker认证，默认空=匿名）
  username: ""
  password: ""

  # 发布主题，默认 opcua/data
  topic: opcua/data

  # 服务质量：0=最多一次 1=至少一次 2=恰好一次，默认0
  qos: 0

  # 保留消息：新订阅者是否立即收到最新数据，默认false
  retained: false

  # 清除会话：断开后Broker是否清除未发送消息，默认true
  clean_session: true

  # 心跳间隔，单位秒，默认60
  keepalive_sec: 60

  # 连接超时，单位秒，默认10
  connect_timeout_sec: 10

  # 发布超时，单位秒，默认5
  publish_timeout_sec: 5

  # 自动重连，默认true
  auto_reconnect: true

  # 最大重连间隔，单位秒，默认60
  max_reconnect_delay_sec: 60

  # TLS客户端证书（可选，双向TLS）
  # tls_cert_file: ""
  # tls_key_file: ""

  # TLS CA证书（可选，验证Broker证书）
  # tls_ca_file: ""

  # 跳过TLS证书验证（仅测试环境！）
  insecure_skip_verify: false


# -------------------- 数据采集器配置 --------------------
collector:
  # 输出目标类型
  # 类型：字符串，可选值 nats / mqtt
  # 默认值：nats
  # 说明：
  #   - nats：推送到NATS（默认，向后兼容）
  #   - mqtt：推送到MQTT
  # 注意：
  #   - nats 模式需要配置 nats 节
  #   - mqtt 模式需要配置 mqtt 节
  output_type: nats
  # 并发Worker数量
  # 类型：整数
  # 默认值：10
  # 说明：处理订阅数据的并发协程数量
  # 建议：
  #   - 10万点位：10-20
  #   - 20万点位：20-30
  #   - 过多会增加CPU开销，过少处理不及时
  worker_count: 10

  # 每批发布的数据点数量
  # 类型：整数
  # 默认值：100
  # 说明：攒够此数量的数据点后，批量发布到NATS
  # 建议：
  #   - 数值越大，批量效率越高，但延迟增加
  #   - 数值越小，延迟低，但网络往返开销大
  batch_size: 100

  # 内部Channel缓冲区大小
  # 类型：整数
  # 默认值：10000
  # 说明：订阅数据到发布之间的缓冲队列大小
  # 建议：
  #   - 应大于 batch_size * worker_count
  #   - 防止数据量大时阻塞订阅
  channel_buffer_size: 10000

  # 发布超时时间
  # 类型：整数，单位毫秒
  # 默认值：5000
  # 说明：批量发布到NATS的超时时间
  publish_timeout_ms: 5000

  # 订阅数据后发布到的NATS主题
  # 类型：字符串
  # 默认值：opcua/data
  # 说明：下游消费者订阅此主题获取数据
  subscription_topic: opcua/data

  # 监控统计输出间隔
  # 类型：整数，单位秒
  # 默认值：60
  # 说明：定期输出采集统计信息（日志级别为info时可见）
  # 设置为0可禁用监控输出
  monitor_interval_sec: 60

  # 数据停滞判定阈值
  # 类型：整数，单位秒
  # 默认值：30
  # 说明：超过此时间未收到数据更新的节点，标记为Stale
  # 建议：
  #   - 应大于 heartbeat_interval_sec，确保心跳验证有机会更新数据
  #   - 过小会导致频繁Stale误报
  #   - 过大则无法及时发现数据停滞
  stale_threshold_sec: 30

  # 健康检查间隔
  # 类型：整数，单位秒
  # 默认值：5
  # 说明：定期主动拉取所有节点数据，验证数据新鲜度
  # 作用：
  #   - 补充订阅丢失的数据
  #   - 验证订阅数据的准确性
  #   - 防止稳态数据被误判为停滞
  heartbeat_interval_sec: 5

  # 推送模式
  # 类型：字符串，可选值 immediate / timed
  # 默认值：timed
  # 说明：控制数据推送到NATS的方式
  #   - immediate（即时模式）：每次变化立即推送
  #   - timed（定时模式）：累积脏标记，定时批量推送全量快照
  # 即时模式：
  #   - 优点：下游实时获取数据
  #   - 缺点：数据量大时网络开销大
  # 定时模式：
  #   - 优点：批量推送效率高，下游获得稳定的数据流
  #   - 缺点：有延迟，取决于 push_interval_sec
  # 建议：
  #   - 下游需要实时数据 → immediate
  #   - 下游需要稳定批量数据，或数据量大 → timed
  push_mode: timed

  # 定时推送间隔（仅定时模式有效）
  # 类型：整数，单位秒
  # 默认值：1
  # 说明：定时模式下的推送间隔，每隔此时间推送一次全量快照
  # 注意：
  #   - 仅在 push_mode=timed 时生效
  #   - 应确保 heartbeat_interval_sec < push_interval_sec
  # 建议：
  #   - 需要高实时性：push_interval_sec = 1
  #   - 需要高吞吐量：push_interval_sec = 5~10
  push_interval_sec: 1

  # 心跳强制推送（即时模式有效）
  # 类型：布尔
  # 默认值：true
  # 说明：即时推送模式下，心跳验证成功后是否强制推送当前值
  # 用途：
  #   - true：确保下游始终有数据流，即使OPC UA没有变化通知
  #   - false：只在数据实际变化时推送
  # 建议：
  #   - 下游需要稳定数据流 → true
  #   - 只关心变化数据 → false
  force_heartbeat: true

  # OPC UA节点ID列表
  # 类型：数组，每个元素为字符串
  # 默认值：无
  # 说明：
  #   - 支持单个节点：ns=2;s=Channel.Device.Tag
  #   - 支持文件夹节点（自动展开为所有叶子标签）
  #   - 支持通配符递归展开
  #
  # NodeID格式说明：
  #   ns=X;s=xxx     - 字符串型（X=命名空间索引）
  #   ns=X;i=123     - 整数型
  #   ns=X;g=xxxx    - GUID型
  #
  # 对接KepServer示例：
  #   - 单个标签：ns=2;s=Channel1.Device1.Temperature
  #   - 设备文件夹（精确模式）：ns=2;s=Channel1.Device1
  #   - 通配递归（穿透所有标记组）：ns=2;s=Channel1.Device1.*
  #
  # 精确模式 vs 通配模式：
  #   无.*后缀 = 仅取当前层级Variable子节点（不穿透标记组）
  #   有.*后缀 = 递归穿透所有Object子文件夹，收集全部Variable叶子
  #   适用场景：
  #     - KepServer无标记组层级 → 精确模式即可
  #     - KepServer有Channel.Device.标记组.Tag四级结构 → 用.*通配
  subscription_nodes:
    - ns=2;s=t1.d1


# -------------------- 点位回写配置 --------------------
writeback:
  # 接收回写命令的主题
  # 类型：字符串
  # 默认值：opcua/write
  # 说明：外部系统发回写命令到此主题，程序收到后执行OPC UA写操作
  # 注：主题类型取决于 output_type — nats 模式下为 NATS Subject，mqtt 模式下为 MQTT Topic
  # 消息格式：
  #   {"node_id":"ns=2;s=t1.d1.Temperature","value":"25.5","value_type":"float64","request_id":"abc123"}
  #   value_type 可选：int32 / int64 / float32 / float64 / bool / string
  #   value_type 为空时自动推断类型
  write_subject: opcua/write

  # 发布回写结果的主题
  # 类型：字符串
  # 默认值：opcua/write/result
  # 说明：每次回写操作完成后，发布结果到此主题
  # 注：主题类型取决于 output_type
  # 结果格式：
  #   {"node_id":"ns=2;s=t1.d1.Temperature","success":true,"written_value":25.5,"request_id":"abc123"}
  result_subject: opcua/write/result
