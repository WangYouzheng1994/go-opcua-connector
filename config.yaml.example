# ============================================================
# go-opcua-connector 配置文件
# 使用说明：
#   1. 复制此文件为 config.yaml
#   2. 根据实际环境修改各项配置
#   3. 支持通过环境变量覆盖配置（将层级以_连接并大写）
#      例如：export OPCUA_ENDPOINT="opc.tcp://192.168.1.100:4840"
# ============================================================

# -------------------- 应用基础配置 --------------------
app_name: go-opcua-connector
# 应用名称，用于日志标识和进程监控
# 类型：字符串
# 默认值：go-opcua-connector
# 建议：保持默认即可

log_level: info
# 日志输出级别
# 类型：字符串，可选值 debug / info / warn / error
# 默认值：info
# 说明：
#   - debug：输出详细调试信息，生产环境慎用
#   - info：输出常规运行信息（推荐）
#   - warn：只输出警告和错误
#   - error：只输出错误信息


# -------------------- OPC UA 服务器配置 --------------------
opcua:
  # OPC UA 服务器连接地址
  # 类型：字符串，格式 opc.tcp://host:port
  # 默认值：无（必填）
  # 示例：
  #   - opc.tcp://localhost:49320        （KepServer默认端口）
  #   - opc.tcp://192.168.1.100:4840     （远程服务器）
  endpoint: opc.tcp://localhost:49320

  # 客户端证书文件路径（用于安全认证）
  # 类型：字符串，文件路径
  # 默认值：空（不使用证书）
  # 说明：使用安全连接时需要提供 X.509 证书
  certificate: ""

  # 客户端私钥文件路径（用于安全认证）
  # 类型：字符串，文件路径
  # 默认值：空（不使用私钥）
  # 说明：需与证书配对使用
  private_key: ""

  # 用户名（用于用户认证）
  # 类型：字符串
  # 默认值：空（匿名连接）
  # 说明：如果服务器需要认证，填写用户名
  username: ""

  # 密码（用于用户认证）
  # 类型：字符串
  # 默认值：空（匿名连接）
  # 说明：与用户名配对使用
  password: ""

  # 安全策略
  # 类型：字符串，可选值 None / Basic128Rsa15 / Basic256 / Basic256Sha256
  # 默认值：None
  # 说明：
  #   - None：不加密，不签名（测试环境）
  #   - Basic128Rsa15：128位加密，RSA15签名（兼容性优先）
  #   - Basic256：256位加密，RSA签名（平衡模式）
  #   - Basic256Sha256：256位加密，SHA256签名（推荐，安全优先）
  security_policy: None

  # 安全模式
  # 类型：字符串，可选值 None / Sign / SignAndEncrypt
  # 默认值：None
  # 说明：
  #   - None：不签名，不加密
  #   - Sign：签名但不加密（验证数据完整性）
  #   - SignAndEncrypt：签名并加密（推荐，完整保护）
  security_mode: None

  # 连接超时时间
  # 类型：整数，单位秒
  # 默认值：30
  # 说明：连接建立超时时间，超时后放弃连接并报错
  connect_timeout: 30

  # 请求超时时间
  # 类型：整数，单位秒
  # 默认值：30
  # 说明：每个OPC UA请求的超时时间
  request_timeout: 30


# -------------------- NATS 消息中间件配置 --------------------
nats:
  # NATS 服务器地址
  # 类型：字符串，支持多个服务器（逗号分隔）
  # 默认值：无（必填）
  # 示例：
  #   - nats://192.168.0.69:4222
  #   - nats://192.168.0.69:4222,nats://192.168.0.70:4222
  urls: nats://192.168.0.69:4222

  # 用户名（用于NATS认证）
  # 类型：字符串
  # 默认值：空（匿名连接）
  # 说明：如果NATS服务器启用了认证，填写用户名
  username: ""

  # 密码（用于NATS认证）
  # 类型：字符串
  # 默认值：空（匿名连接）
  # 说明：与用户名配对使用
  password: ""

  # 最大重连次数
  # 类型：整数
  # 默认值：-1（无限重试）
  # 说明：
  #   - -1：无限重连，直到连接成功
  #   - 0：不重连，连接失败直接报错
  #   - N>0：最多重连N次后放弃
  max_reconnects: -1

  # 重连等待时间
  # 类型：整数，单位毫秒
  # 默认值：1000
  # 说明：每次重连失败后，等待多久再尝试
  reconnect_wait_ms: 1000


# -------------------- 数据采集器配置 --------------------
collector:
  # 并发Worker数量
  # 类型：整数
  # 默认值：10
  # 说明：处理订阅数据的并发协程数量
  # 建议：
  #   - 10万点位：10-20
  #   - 20万点位：20-30
  #   - 过多会增加CPU开销，过少处理不及时
  worker_count: 10

  # 每批发布的数据点数量
  # 类型：整数
  # 默认值：100
  # 说明：攒够此数量的数据点后，批量发布到NATS
  # 建议：
  #   - 数值越大，批量效率越高，但延迟增加
  #   - 数值越小，延迟低，但网络往返开销大
  batch_size: 100

  # 内部Channel缓冲区大小
  # 类型：整数
  # 默认值：10000
  # 说明：订阅数据到发布之间的缓冲队列大小
  # 建议：
  #   - 应大于 batch_size * worker_count
  #   - 防止数据量大时阻塞订阅
  channel_buffer_size: 10000

  # 发布超时时间
  # 类型：整数，单位毫秒
  # 默认值：5000
  # 说明：批量发布到NATS的超时时间
  # 同时也是：空批次时的刷新间隔（防止数据一直不发布）
  publish_timeout_ms: 5000

  # 订阅数据后发布到的NATS主题
  # 类型：字符串
  # 默认值：opcua/data
  # 说明：下游消费者订阅此主题获取数据
  subscription_topic: opcua/data

  # 监控统计输出间隔
  # 类型：整数，单位秒
  # 默认值：60
  # 说明：定期输出采集统计信息（日志级别为info时可见）
  # 设置为0可禁用监控输出
  monitor_interval_sec: 60

  # 数据停滞判定阈值
  # 类型：整数，单位秒
  # 默认值：10
  # 说明：超过此时间未收到数据更新的节点，标记为Stale
  # 用途：用于监控数据是否正常采集
  stale_threshold_sec: 10

  # 心跳验证拉取间隔
  # 类型：整数，单位秒
  # 默认值：5
  # 说明：定期主动拉取所有节点数据，验证数据新鲜度
  # 作用：
  #   - 补充订阅丢失的数据
  #   - 验证订阅数据的准确性
  #   - 防止数据停滞误报
  heartbeat_interval_sec: 5

  # OPC UA节点ID列表
  # 类型：数组，每个元素为字符串
  # 默认值：无
  # 说明：
  #   - 支持单个节点：ns=2;s=Channel.Device.Tag
  #   - 支持文件夹节点（自动展开为所有叶子标签）
  #   - 支持多种NodeID格式
  #
  # NodeID格式说明：
  #   ns=X;s=xxx     - 字符串型（X=命名空间索引）
  #   ns=X;i=123     - 整数型
  #   ns=X;g=xxxx    - GUID型
  #
  # 对接KepServer示例：
  #   - 单个标签：ns=2;s=Channel1.Device1.Temperature
  #   - 设备文件夹（仅展开直接Tag）：ns=2;s=Channel1.Device1
  #   - 通道文件夹（仅展开直接Tag）：ns=2;s=Channel1
  #   - 通配递归（穿透标记组，收集所有层级Tag）：ns=2;s=Channel1.Device1.*
  #
  # 精确模式 vs 通配模式：
  #   无.*后缀 = 仅取当前层级Variable子节点（不穿透标记组）
  #   有.*后缀 = 递归穿透所有Object子文件夹，收集全部Variable叶子
  #   适用场景：
  #     - KepServer无标记组层级 → 精确模式即可
  #     - KepServer有Channel.Device.标记组.Tag四级结构 → 用.*通配
  subscription_nodes:
    - ns=2;s=t1.d1


# -------------------- 点位回写配置 --------------------
writeback:
  # 接收回写命令的NATS主题
  # 类型：字符串
  # 默认值：opcua/write
  # 说明：外部系统发回写命令到此主题，程序收到后执行OPC UA写操作
  # 消息格式：
  #   {"node_id":"ns=2;s=t1.d1.Temperature","value":"25.5","value_type":"float64","request_id":"abc123"}
  #   value_type 可选：int32 / int64 / float32 / float64 / bool / string
  #   value_type 为空时自动推断类型
  write_subject: opcua/write

  # 发布回写结果的NATS主题
  # 类型：字符串
  # 默认值：opcua/write/result
  # 说明：每次回写操作完成后，发布结果到此主题
  # 结果格式：
  #   {"node_id":"ns=2;s=t1.d1.Temperature","success":true,"written_value":25.5,"request_id":"abc123"}
  result_subject: opcua/write/result
